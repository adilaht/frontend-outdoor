# URL API Backend Server (Express.js)
# Ganti dengan URL IP VPS Backend atau domain saat deploy ke production
# Contoh: http://192.168.1.100:5000 atau https://api.domain.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Client Key Midtrans untuk Snap Popup Frontend
# Ambil dari dashboard Midtrans (Settings > Access Keys > Client Key)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx

# URL Webhook N8N (Atau bot CS lainnya)
# Digunakan untuk fitur Chat Customer Service
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat-cs
